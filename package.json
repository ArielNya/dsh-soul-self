{
    "name":  "dsh-soul-md",
    "version":  "0.4.0",
    "description":  "DeepSeek Harness 的 soul.md 风格人设 + 长期记忆插件：多人设三级解析（会话选择 > 工作区卡片 > 全局）、记忆按角色/工作区/全局分级存储、聊天框一键切人设、AI 可自行演化人设与记忆；Web UI 设置栏。",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "platform":  "web"
                           }
            },
    "files":  [
                  "index.js",
                  "client.js",
                  "README.md",
                  "README.zh.md",
                  "LICENSE",
                  "examples",
                  "vendor"
              ],
    "homepage":  "https://github.com/Scorp1o117/dsh-soul-md",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "persona",
                     "soul",
                     "memory",
                     "roleplay",
                     "system-prompt"
                 ],
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=20.18"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Scorp1o117/dsh-soul-md.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/Scorp1o117/dsh-soul-md/issues"
             },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     },
    "peerDependencies":  {
                             "react":  "^18.2.0",
                             "@deepseek-ai/dsh-home-paths":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-settings":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         }
}