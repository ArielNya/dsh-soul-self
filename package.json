{
  "name": "dsh-soul-md",
  "version": "0.2.0",
  "description": "soul.md-style persona injection for DeepSeek Harness: load a markdown persona card into the system prompt with hot reload on file change.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "examples"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "soul",
    "roleplay",
    "system-prompt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-soul-md.git"
  },
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-soul-md/issues"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
