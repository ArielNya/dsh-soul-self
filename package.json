{
    "name": "dsh-soul-self",
    "version": "0.6.0",
    "description": "DeepSeek Harness soul plugin fork: mechanism stub + self-written persona via soul_update, long-term memory, coding tools kept. The user does not write a character bible.",
    "type": "module",
    "main": "index.js",
    "exports": {
                    ".": "./index.js",
                    "./client": "./client.js",
                    "./package.json": "./package.json"
                },
    "dsh": {
                "bundle": {
                               "patch": "./cordis.patch.yml"
                           },
                "client": {
                               "platform": "web"
                           }
            },
    "files": [
                  "index.js",
                  "soul-lib.js",
                  "client.js",
                  "cordis.patch.yml",
                  "README.md",
                  "README.zh.md",
                  "LICENSE",
                  "examples"
              ],
    "homepage": "https://github.com/ArielNya/dsh-soul-self",
    "keywords": [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "persona",
                     "soul",
                     "memory",
                     "self-evolving"
                 ],
    "license": "MIT",
    "engines": {
                    "node": ">=20.18"
                },
    "repository": {
                       "type": "git",
                       "url": "git+https://github.com/ArielNya/dsh-soul-self.git"
                   },
    "bugs": {
                 "url": "https://github.com/ArielNya/dsh-soul-self/issues"
             },
    "dependencies": {
                         "@deepseek-ai/schemastery": "^3.18.1"
                     },
    "peerDependencies": {
                             "react": "^18.2.0",
                             "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7 || ^0.1.1-rc.1",
                             "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1",
                             "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.1"
                         },
    "scripts": {
                    "test": "node --test tests/*.test.mjs"
                }
}
